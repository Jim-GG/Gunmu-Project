        {
            "m_Id": "8b56206d01334608a2708405c25e869c"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "FlowUV",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float2 p=UV*2-1; float r=length(p); float n=(NoiseValue-.5)*1.2+sin(p.x*14+_Time.y*3+sin(p.y*9-_Time.y*2))*sin(p.y*11-_Time.y*2)*.45; float2 dir=normalize(p+0.001);float2 turbulence=float2(sin(p.y*17+_Time.y*2),cos(p.x*13-_Time.y*3));float ring=smoothstep(.28,.55,r)*(1-smoothstep(.82,1,r));float sphere=pow(1-saturate(abs(dot(normalize(Normal),normalize(View)))),1.5);float steam=(1-smoothstep(.3,1,r))*.25;float mask=Mode<.5?ring:Mode<1.5?sphere:steam;mask*=saturate(1-Progress)*Color.a;float2 offset=(dir*(.6+n*.4)+turbulence*.3)*Distortion*mask;R=float4(Screen.xy+offset+dir*Chromatic*mask,0,1);G=float4(Screen.xy+offset,0,1);B=float4(Screen.xy+offset-dir*Chromatic*mask,0,1);Alpha=saturate(mask*Opacity);"
}

