    "m_SourceType": 1,
    "m_FunctionName": "CraterSurface",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "Normal=normalize(float3(N.xy*Strength,max(.05,N.z)));Occlusion=lerp(1,AO,saturate(AOStrength));Opacity=Mask*CrackOpacity*(1-smoothstep(FadeStart,FadeEnd,length(UV*2-1)));"
}

