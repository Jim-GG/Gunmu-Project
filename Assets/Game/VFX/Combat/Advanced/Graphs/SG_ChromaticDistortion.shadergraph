    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "ScreenRefraction",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float2 size=max(_ScaledScreenParams.xy,1);float2 p=UV*2-1;float2 radial=normalize((Screen.xy-Center)*size+0.001);float2 signedNoise=float2(A.r+B.g-1,(A.g-B.r)*.5);float ring=1-smoothstep(HalfWidth,HalfWidth+EdgeSoftness,abs(length(p)-(RingRadius+(A.r-.5)*NoiseStrength)));float sphere=lerp(pow(1-saturate(abs(dot(normalize(Normal),normalize(View)))),.8),.65,InsideSphere);float plume=(1-smoothstep(.5,1,abs(p.x)))*smoothstep(0,.08,UV.y)*(1-smoothstep(.45,1,UV.y));float mask=Mode<.5?ring:Mode<1.5?sphere:plume;mask*=pow(saturate(1-Lifecycle),1.2)*Opacity;float edge=min(min(Screen.x,1-Screen.x),min(Screen.y,1-Screen.y));mask*=smoothstep(0,.035,edge);mask*=step(.0001,abs(Distortion)+abs(Chromatic));float2 field=Mode>1.5?signedNoise:radial*(.7+signedNoise.x*.3)+signedNoise*.25;float2 shift=field*Distortion*mask/size;float2 split=radial*Chromatic*mask/size;R=float4(saturate(Screen.xy+shift+split),0,1);G=float4(saturate(Screen.xy+shift),0,1);Buv=float4(saturate(Screen.xy+shift-split),0,1);Alpha=saturate(mask);"
}

