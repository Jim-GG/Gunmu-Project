    },
    "m_SourceType": 1,
    "m_FunctionName": "SurfaceEnergy",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float pattern=smoothstep(Threshold,Threshold+.12,A.r*.65+B.g*.35+Electric.r*.3);float region=Vertex.a*Mask.r;float gathering=smoothstep(Vertex.g-.25,Vertex.g+.2,Charge+.1);Alpha=pattern*region*gathering*Opacity*Charge;Color=Tint.rgb*Intensity*(.4+Charge*2)*(.6+pattern*.4);"
}

