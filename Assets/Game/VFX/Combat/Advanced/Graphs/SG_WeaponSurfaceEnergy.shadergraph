    },
    "m_SourceType": 1,
    "m_FunctionName": "SurfaceFlowUV",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float t=_Time.y*Speed*(.5+Charge*1.5);A=UV*float2(6,2)-Direction*t;B=UV*float2(9,3)+float2(-Direction.x*.57,-Direction.y*.73)*t;Electric=UV*float2(2,1)-Direction*t*.4;"
}

